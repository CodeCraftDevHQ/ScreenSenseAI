<Window x:Class="ScreenTranslator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenTranslator.Localization"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[Settings]}"
        Width="620" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        PreviewMouseWheel="OnWindowPreviewMouseWheel"
        FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,8,4,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Width="110" Height="32" Margin="6,0,0,0" Click="OnSave"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Save]}" />
            <Button x:Name="CancelButton" Width="110" Height="32" Margin="6,0,0,0" Click="OnCancel"
                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Cancel]}" />
        </StackPanel>

        <TabControl>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabGeneral]}">
                <StackPanel Margin="14">
                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[UiLanguage]}" />
                    <ComboBox x:Name="UiLanguageBox" SelectionChanged="OnUiLanguageChanged">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="فارسی" Tag="fa" />
                    </ComboBox>

                    <CheckBox x:Name="StartWithWindowsBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[StartWithWindows]}" />
                    <CheckBox x:Name="ActiveMonitorBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ActiveMonitorOnly]}" />
                    <CheckBox x:Name="CacheBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[CacheTranslations]}" />

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[IconOpacity]}" />
                    <Slider x:Name="IconOpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                    <Button x:Name="ResetButton" Height="30" Width="200" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OnResetToDefaults"
                            Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ResetToDefaults]}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabLanguages]}">
                <StackPanel Margin="14">
                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[SourceLanguage]}" />
                    <ComboBox x:Name="SourceLanguageBox" />

                    <Button x:Name="SwapButton" Height="30" Margin="0,10,0,10" Click="OnSwap"
                            Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[SwapLanguages]}" />

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[TargetLanguage]}" />
                    <ComboBox x:Name="TargetLanguageBox" />

                    <CheckBox x:Name="AutoDetectBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[AutoDetect]}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabShortcuts]}">
                <StackPanel Margin="14">
                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[TranslateHotkey]}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" Click="OnRecordClick" Tag="translate"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Record]}" />
                        <TextBox x:Name="TranslateTriggerBox" IsReadOnly="True" Focusable="False" />
                    </DockPanel>

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ClearHotkey]}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" Click="OnRecordClick" Tag="clear"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Record]}" />
                        <TextBox x:Name="ClearTriggerBox" IsReadOnly="True" Focusable="False" />
                    </DockPanel>

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[RegionHotkey]}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" Click="OnRecordClick" Tag="region"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Record]}" />
                        <TextBox x:Name="RegionTriggerBox" IsReadOnly="True" Focusable="False" />
                    </DockPanel>

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[SavedRegionHotkey]}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" Click="OnRecordClick" Tag="savedregion"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Record]}" />
                        <TextBox x:Name="SavedRegionTriggerBox" IsReadOnly="True" Focusable="False" />
                    </DockPanel>

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[AdHocRegionHotkey]}" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" Click="OnRecordClick" Tag="adhocregion"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Record]}" />
                        <TextBox x:Name="AdHocRegionTriggerBox" IsReadOnly="True" Focusable="False" />
                    </DockPanel>

                    <TextBlock x:Name="RecordingHintText" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />

                    <CheckBox x:Name="CtrlBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[RequireCtrl]}" />
                    <CheckBox x:Name="AltBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[RequireAlt]}" />
                    <CheckBox x:Name="ShiftBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[RequireShift]}" />
                    <CheckBox x:Name="SwallowBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[SwallowHotkey]}" />

                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[MouseTriggerWarning]}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#C97B00" FontSize="11" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabOcr]}">
                <StackPanel Margin="14">
                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[OcrEngine]}" />
                    <ComboBox x:Name="OcrEngineBox">
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[WindowsOcr]}" Tag="WindowsBuiltIn" />
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[TesseractOcr]}" Tag="Tesseract" />
                    </ComboBox>

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[TessdataPath]}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" Click="OnBrowseTessdata"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Browse]}" />
                        <TextBox x:Name="TessdataBox" />
                    </DockPanel>

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[MinConfidence]}" />
                    <Slider x:Name="ConfidenceSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                    <TextBlock x:Name="OcrLanguagesText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabTranslation]}">
                <ScrollViewer>
                    <StackPanel Margin="14">
                        <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Provider]}" />
                        <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged">
                            <ComboBoxItem Content="Offline dictionary (no setup, word-by-word, EN &lt;-&gt; FA only)" Tag="OfflineDictionary" />
                            <ComboBoxItem Content="LibreTranslate (local server, better quality)" Tag="LibreTranslate" />
                            <ComboBoxItem Content="Ollama (local AI model, best offline quality)" Tag="Ollama" />
                            <ComboBoxItem Content="LM Studio (local AI model already running on your machine)" Tag="LmStudio" />
                            <ComboBoxItem Content="Cloud AI with your own API key (Gemini, OpenAI, Claude, OpenRouter, Groq...)" Tag="CloudAi" />
                            <ComboBoxItem Content="Azure Translator (needs internet + key)" Tag="Azure" />
                            <ComboBoxItem Content="DeepL (needs internet + key)" Tag="DeepL" />
                        </ComboBox>

                        <TextBlock x:Name="ProviderHintText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />

                        <StackPanel x:Name="AzurePanel" Visibility="Collapsed">
                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[AzureKey]}" />
                            <TextBox x:Name="AzureKeyBox" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[AzureRegion]}" />
                            <TextBox x:Name="AzureRegionBox" />
                        </StackPanel>

                        <StackPanel x:Name="DeepLPanel" Visibility="Collapsed">
                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[DeepLKey]}" />
                            <TextBox x:Name="DeepLKeyBox" />
                        </StackPanel>

                        <StackPanel x:Name="LibrePanel" Visibility="Collapsed">
                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[LibreUrl]}" />
                            <TextBox x:Name="LibreUrlBox" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[LibreKey]}" />
                            <TextBox x:Name="LibreKeyBox" />
                        </StackPanel>

                        <StackPanel x:Name="OllamaPanel" Visibility="Collapsed">
                            <Label Content="Ollama server URL" />
                            <TextBox x:Name="OllamaUrlBox" />

                            <Label Content="Ollama model name" />
                            <TextBox x:Name="OllamaModelBox" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Temperature]}" />
                            <Slider x:Name="OllamaTemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[PromptTemplate]}" />
                            <TextBox x:Name="OllamaPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[PromptTemplateHint]}"
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="LmStudioPanel" Visibility="Collapsed">
                            <Label Content="LM Studio server URL" />
                            <TextBox x:Name="LmStudioUrlBox" />

                            <Label Content="LM Studio model name (optional, leave blank to use the loaded model)" />
                            <TextBox x:Name="LmStudioModelBox" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Temperature]}" />
                            <Slider x:Name="LmStudioTemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[PromptTemplate]}" />
                            <TextBox x:Name="LmStudioPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[PromptTemplateHint]}"
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="CloudAiPanel" Visibility="Collapsed">
                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiService]}" />
                            <ComboBox x:Name="CloudAiPresetBox" SelectionChanged="OnCloudPresetChanged" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiKey]}" />
                            <PasswordBox x:Name="CloudAiKeyBox" Padding="4" />
                            <TextBlock x:Name="CloudAiHelpText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />

                            <StackPanel x:Name="CloudAiBaseUrlPanel" Visibility="Collapsed">
                                <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiBaseUrl]}" />
                                <TextBox x:Name="CloudAiBaseUrlBox" />
                            </StackPanel>

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiModel]}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CloudAiModelBox" IsEditable="True" Grid.Column="0" />
                                <Button x:Name="LoadModelsButton" Grid.Column="1" Margin="6,0,0,0" Padding="12,0" Click="OnLoadModels"
                                        Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[LoadModels]}" />
                            </Grid>

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Temperature]}" />
                            <Slider x:Name="CloudAiTemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                            <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiExtra]}" />
                            <TextBox x:Name="CloudAiExtraBox" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiExtraHint]}"
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />

                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[CloudAiPrivacy]}"
                                       TextWrapping="Wrap" Foreground="IndianRed" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>

                        <Button x:Name="TestButton" Height="30" Margin="0,14,0,0" Click="OnTestProvider"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[TestConnection]}" />

                        <TextBlock x:Name="TestResultText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabAppearance]}">
                <StackPanel Margin="14">
                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[OverlayFont]}" />
                    <ComboBox x:Name="FontBox" IsEditable="True" />

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[OverlayOpacity]}" />
                    <Slider x:Name="OverlayOpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[MaxFontSize]}" />
                    <Slider x:Name="MaxFontSlider" Minimum="10" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" />

                    <CheckBox x:Name="HoverOriginalBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ShowOriginalOnHover]}" />
                    <CheckBox x:Name="AutoHideBox" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[AutoHideOverlay]}" />

                    <Label Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[OverlayTimeout]}" />
                    <Slider x:Name="TimeoutSlider" Minimum="3" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[TabAbout]}">
                <StackPanel Margin="14">
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutText]}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ThirdParty]}" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBox x:Name="NoticesBox" IsReadOnly="True" AcceptsReturn="True" Height="280"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
