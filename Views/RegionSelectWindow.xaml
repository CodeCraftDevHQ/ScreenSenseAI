<Window x:Class="ScreenTranslator.Views.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowStartupLocation="Manual">
    <Canvas x:Name="RootCanvas">
        <Rectangle x:Name="SelectionRect"
                   Stroke="#4DA3FF" StrokeThickness="2"
                   Fill="#334DA3FF" Visibility="Collapsed" />
    </Canvas>
</Window>
